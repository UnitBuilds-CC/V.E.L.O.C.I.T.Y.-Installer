ci:
  provider: "GitHub Actions"
  workflow: ".github/workflows/ci.yml"
  jobs:
    - "lint (clippy + fmt)"
    - "test (all platforms)"
    - "build release (all platforms)"
    - "sign-windows (tagged releases)"
    - "sign-macos (tagged releases)"
    - "sign-linux (tagged releases)"

